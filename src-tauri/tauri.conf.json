{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Sync Observer",
  "version": "0.1.8",
  "identifier": "in.sociobot.local-sync-observer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [
      {
        "title": "Local Sync Observer",
        "width": 1180,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Read-only convergence dashboard for local-first tools",
    "longDescription": "Observe Syncthing and local folder metadata from one truthful, read-only desktop dashboard.",
    "copyright": "Copyright © 2026 Sociobot",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
